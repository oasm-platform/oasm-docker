# SHARED CONFIGURATION
IMAGE_TAG=latest
OASM_CLOUD_APIKEY=change_me

# OASM CORE CONFIGURATION
POSTGRES_HOST=postgres
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
POSTGRES_DB=open_asm
POSTGRES_SSL=false
PORT=6277
REDIS_URL=redis://:open_asm@redis:6379/0
REDIS_PASSWORD=open_asm

# Signs session cookies and email verification links. Required: newer core-api
# images won't start without it, older ones fall back to a publicly known
# default. Generate one with: openssl rand -base64 32
# Changing it signs everyone out and voids verification links already sent.
BETTER_AUTH_SECRET=

# Public URL of the console, origin only (e.g. https://cloud.oasm.io). Used for
# email verification links and the Telegram webhook.
BASE_URL=

# Reverse proxies in front of core-api (comma-separated IPs or CIDRs), so the
# client IP is read from X-Forwarded-For past them: login rate limits, sessions
# and worker IPs. Empty: every request looks like it came from the console's
# nginx. Behind a tunnel or proxy on this compose network, use its subnet:
#   docker network inspect oasm_net -f '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
# List only addresses clients cannot connect from, or they can forge their IP.
TRUSTED_PROXIES=

# Envelope encryption: comma-separated keys protecting stored credentials. The
# last key encrypts; earlier keys only decrypt. Required: core-api won't start
# unless the last key is random and 32+ characters. Generate one with:
#   openssl rand -base64 32
# To rotate, add the new key at the end; core-api re-encrypts stored secrets
# with it at boot. A stack set up before this reached core-api stored data
# under a built-in default key: just set a key here, that data stays readable.
ENCRYPTION_KEYS=

# GeoIP CONFIGURATION
GEO_IP_URL=geo-ip-database:4360

# RustFS Configuration
RUSTFS_ENDPOINT=http://rustfs:9000
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfssecret

# Number of oasm-worker replicas started by `make` / `docker compose up`
WORKER_REPLICAS=3
